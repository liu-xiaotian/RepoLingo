generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model apikey {
  id           String   @id
  userId       String
  provider     String   @default("openrouter")
  encryptedKey String   @db.Text
  isActive     Boolean  @default(true)
  defaultModel String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ApiKey_userId_fkey")

  @@index([userId], map: "ApiKey_userId_idx")
}

model repoconfig {
  id                String     @id
  repositoryId      String     @unique(map: "RepoConfig_repositoryId_key")
  baseLanguage      String     @default("zh-CN")
  targetLanguages   Json
  includePaths      Json?
  excludePaths      Json?
  translationBranch String     @default("translations")
  aiModel           String?
  autoTranslate     Boolean    @default(false)
  webhookId         Int?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime
  repository        repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade, map: "RepoConfig_repositoryId_fkey")
}

model repository {
  id              String            @id
  userId          String
  githubRepoId    Int               @unique(map: "Repository_githubRepoId_key")
  owner           String
  name            String
  fullName        String
  description     String?           @db.Text
  defaultBranch   String            @default("main")
  isPrivate       Boolean           @default(false)
  lastSyncedAt    DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  repoconfig      repoconfig?
  user            user              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Repository_userId_fkey")
  translationtask translationtask[]

  @@index([fullName], map: "Repository_fullName_idx")
  @@index([userId], map: "Repository_userId_idx")
}

model systemconfig {
  id          String   @id
  key         String   @unique(map: "SystemConfig_key_key")
  value       String   @db.Text
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model translatedfile {
  id                String                @id
  translationTaskId String
  sourcePath        String
  targetPath        String
  targetLanguage    String
  status            translatedfile_status @default(PENDING)
  sourceContent     String?               @db.LongText
  translatedContent String?               @db.LongText
  tokensUsed        Int?
  errorMessage      String?               @db.Text
  createdAt         DateTime              @default(now())
  updatedAt         DateTime
  translationtask   translationtask       @relation(fields: [translationTaskId], references: [id], onDelete: Cascade, map: "TranslatedFile_translationTaskId_fkey")

  @@index([status], map: "TranslatedFile_status_idx")
  @@index([translationTaskId], map: "TranslatedFile_translationTaskId_idx")
}

model translationtask {
  id                String                 @id
  userId            String
  repositoryId      String
  status            translationtask_status @default(PENDING)
  type              translationtask_type   @default(FULL)
  targetLanguages   Json
  totalFiles        Int                    @default(0)
  completedFiles    Int                    @default(0)
  failedFiles       Int                    @default(0)
  progress          Float                  @default(0)
  errorMessage      String?                @db.Text
  pullRequestUrl    String?
  pullRequestNumber Int?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime
  translatedfile    translatedfile[]
  repository        repository             @relation(fields: [repositoryId], references: [id], onDelete: Cascade, map: "TranslationTask_repositoryId_fkey")
  user              user                   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "TranslationTask_userId_fkey")

  @@index([repositoryId], map: "TranslationTask_repositoryId_idx")
  @@index([status], map: "TranslationTask_status_idx")
  @@index([userId], map: "TranslationTask_userId_idx")
}

model user {
  id              String            @id @default(cuid())
  githubId        Int               @unique(map: "User_githubId_key")
  login           String
  name            String?
  email           String?
  avatarUrl       String?
  accessToken     String            @db.Text
  installationId  Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  apikey          apikey[]
  repository      repository[]
  translationtask translationtask[]
  userusage       userusage[]

  @@index([githubId], map: "User_githubId_idx")
  @@index([login], map: "User_login_idx")
}

model userusage {
  id        String   @id
  userId    String
  date      String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "UserUsage_userId_fkey")

  @@unique([userId, date], map: "UserUsage_userId_date_key")
  @@index([date], map: "UserUsage_date_idx")
  @@index([userId], map: "UserUsage_userId_idx")
}

enum translationtask_status {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum translationtask_type {
  FULL
  INCREMENTAL
}

enum translatedfile_status {
  PENDING
  TRANSLATING
  COMPLETED
  FAILED
  SKIPPED
}
